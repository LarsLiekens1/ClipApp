# Days to keep job folders in work/ before they are deleted at startup (0 = never delete).
# CLIPAPP_KEEP_DAYS=7

# Gmail address used with the Google OAuth account.
GMAIL_FROM=your.address@gmail.com

# Optional override for the Google OAuth desktop-client JSON file.
# Default: %USERPROFILE%\.clipapp\google_oauth_client.json
# GOOGLE_OAUTH_CLIENT_FILE=C:\path\to\google_oauth_client.json
